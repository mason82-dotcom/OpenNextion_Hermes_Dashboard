# Template rendered by scripts/pi/install-autostart.sh (@ROOT@ = repository).
# Hermes Touch bridge on 127.0.0.1:8765: read-only status plus optional
# whitelisted quick commands. Never modifies Hermes configuration.
[Unit]
Description=Hermes Touch status bridge (loopback only)
After=hermes-dashboard.service hermes-gateway.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@ROOT@
# run-local.sh loads the private config/bridge.env; no secrets in this unit.
ExecStart=/usr/bin/bash "@ROOT@/scripts/pi/run-local.sh"
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
