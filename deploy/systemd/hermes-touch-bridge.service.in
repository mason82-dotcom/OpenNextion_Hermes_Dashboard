# Template rendered by scripts/pi/install-autostart.sh (@ROOT@ = repository).
# Read-only Hermes Touch bridge on 127.0.0.1:8765. Never modifies Hermes.
[Unit]
Description=Hermes Touch read-only status bridge (loopback only)
After=hermes-dashboard.service hermes-gateway.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@ROOT@
# run-local.sh loads the private config/bridge.env; no secrets in this unit.
ExecStart=/usr/bin/bash "@ROOT@/scripts/pi/run-local.sh"
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
