#pragma once
// 0 = connected mode; without a local Config.h, firmware builds offline demo mode.
#define HT_DEMO_MODE 0
// Create Config.h in this directory. Do not commit it.
// Use only the Hermes TOUCH bridge token, never the Hermes API key.
#define HT_WIFI_SSID "YOUR_2G4_WIFI_SSID"
#define HT_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#define HT_BRIDGE_URL "https://192.168.1.50:8766"
#define HT_DEVICE_TOKEN "PASTE_YOUR_LOCAL_BRIDGE_TOKEN_HERE"

// Requires locally generated LocalCa.h with the public CA PEM.
// HTTPS only; firmware rejects HTTP and missing/invalid CA/NTP time.

// Optional LOCAL-ONLY Dual MIC Board VU/PTT diagnostics. 0 = default OFF.
// Private Config.h opt-in: up to 4s raw PCM TEMPORARILY in PSRAM,
// explicitly overwritten and freed after PTT. No persistence or sending.
#define HT_MIC_TEST_ENABLED 0


// Optional, independent LOCAL ONLY NS4168 output test.
// Off unless explicitly enabled in private Config.h.
// Generates only a fixed 250ms quiet tone via I2S1; no mic playback,
// no Hermes text-to-speech, no audio upload/download, no agent write.
#define HT_SPEAKER_TEST_ENABLED 0


// USB-local CST826 raw touch coordinate calibration, default OFF.
// Enable only temporarily in private Config.h; allows volatile T0..T7
// profile selection over 115200 baud USB serial. No saved config or telemetry.
#define HT_TOUCH_CALIBRATION_ENABLED 0
